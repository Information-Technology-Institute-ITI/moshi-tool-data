{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/manifest_record.schema.json",
  "title": "Kyutai Moshi JSONL manifest record",
  "type": "object",
  "required": ["path", "duration"],
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.wav$"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
