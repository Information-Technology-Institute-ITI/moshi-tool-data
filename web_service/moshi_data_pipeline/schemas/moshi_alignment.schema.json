{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/moshi_alignment.schema.json",
  "title": "Kyutai Moshi word alignments",
  "type": "object",
  "required": ["alignments"],
  "additionalProperties": false,
  "properties": {
    "alignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          {
            "const": "SPEAKER_MAIN"
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}
