[Unit]
Description=Moshi private GPU intake
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/home/ubuntu/moshi-tool-data
ConditionPathIsDirectory=/home/ubuntu/moshi-worker-cache

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/moshi-tool-data
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/.config/moshi/gpu-intake.env
EnvironmentFile=/home/ubuntu/.config/moshi/gpu-intake-token.env
EnvironmentFile=/home/ubuntu/.config/moshi/huggingface.env
EnvironmentFile=/home/ubuntu/.config/moshi/worker-token.env
ExecStart=/home/ubuntu/moshi-tool-data/.venv/bin/python -m moshi_data_pipeline.gpu_intake_main
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/moshi-worker-cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
