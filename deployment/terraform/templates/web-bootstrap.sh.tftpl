#!/usr/bin/env bash
set -euo pipefail
exec > >(tee /var/log/moshi-bootstrap.log | logger -t moshi-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y awscli docker.io nginx sqlite3
systemctl enable --now docker

volume_serial="$(printf '%s' '${workspace_volume_id}' | tr -d '-')"
device=""
for attempt in $(seq 1 120); do
  candidate="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${volume_serial}"
  if [ -e "$${candidate}" ]; then
    device="$${candidate}"
    break
  fi
  device="$(lsblk -ndo PATH,SERIAL | awk -v serial="$${volume_serial}" '$2 == serial {print $1; exit}')"
  [ -n "$${device}" ] && break
  sleep 2
done
[ -n "$${device}" ] || { echo "Workspace EBS volume did not appear"; exit 1; }

if ! blkid "$${device}" >/dev/null 2>&1; then
  mkfs.ext4 -L moshi-workspace "$${device}"
fi
mkdir -p /data
volume_uuid="$(blkid -s UUID -o value "$${device}")"
grep -q "UUID=$${volume_uuid} " /etc/fstab || \
  printf 'UUID=%s /data ext4 defaults,nofail 0 2\n' "$${volume_uuid}" >> /etc/fstab
mountpoint -q /data || mount /data
mkdir -p /data/studio_workspace /data/backups

aws ecr get-login-password --region '${aws_region}' | \
  docker login --username AWS --password-stdin '${registry_host}'
worker_token="$(aws ssm get-parameter --region '${aws_region}' \
  --name '${worker_token_parameter}' --with-decryption \
  --query Parameter.Value --output text)"

umask 077
printf 'MOSHI_WORKER_TOKEN=%s\n' "$${worker_token}" > /run/moshi-web.env
printf 'MOSHI_WORKSPACE=/data/studio_workspace\n' >> /run/moshi-web.env
printf 'MOSHI_GPU_INSTANCE_ID=${processing_instance_id}\n' >> /run/moshi-web.env
printf 'MOSHI_DEPLOYMENT_GENERATION=${image_tag}\n' >> /run/moshi-web.env
printf 'MOSHI_TRUSTED_ORIGINS=https://${domain_name}\n' >> /run/moshi-web.env
printf 'MOSHI_CLOUDWATCH_NAMESPACE=Moshi/Studio\n' >> /run/moshi-web.env
printf 'MOSHI_BACKUP_DIRECTORY=/data/backups\n' >> /run/moshi-web.env
printf 'AWS_REGION=${aws_region}\n' >> /run/moshi-web.env
unset worker_token

docker pull '${image}'
docker rm -f moshi-web >/dev/null 2>&1 || true
docker run -d \
  --name moshi-web \
  --restart unless-stopped \
  --network host \
  --env-file /run/moshi-web.env \
  --volume /data/studio_workspace:/data/studio_workspace \
  '${image}'

cat >/usr/local/sbin/moshi-sqlite-backup <<'BACKUP'
#!/usr/bin/env bash
set -euo pipefail
database=/data/studio_workspace/catalog.sqlite3
destination=/data/backups
[ -f "$database" ] || exit 0
mkdir -p "$destination"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
temporary="$destination/.catalog-$timestamp.sqlite3.tmp"
final="$destination/catalog-$timestamp.sqlite3"
sqlite3 "$database" ".backup '$temporary'"
sqlite3 "$temporary" 'PRAGMA integrity_check;' | grep -qx ok
sha256sum "$temporary" > "$final.sha256.tmp"
mv "$temporary" "$final"
sed -i "s|$temporary|$final|" "$final.sha256.tmp"
mv "$final.sha256.tmp" "$final.sha256"
find "$destination" -maxdepth 1 -type f \
  \( -name 'catalog-*.sqlite3' -o -name 'catalog-*.sqlite3.sha256' \) \
  -mtime +${backup_retention_days} -delete
BACKUP
chmod 0750 /usr/local/sbin/moshi-sqlite-backup

cat >/etc/systemd/system/moshi-sqlite-backup.service <<'UNIT'
[Unit]
Description=Create a consistent Moshi SQLite backup
RequiresMountsFor=/data

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/moshi-sqlite-backup
UNIT

cat >/etc/systemd/system/moshi-sqlite-backup.timer <<'TIMER'
[Unit]
Description=Daily Moshi SQLite backup

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
TIMER
systemctl daemon-reload
systemctl enable --now moshi-sqlite-backup.timer

# TLS and Basic Auth material are deliberately not carried in Terraform state or user data.
# Complete /etc/nginx using deployment/configure-web.ps1 after DNS and certificates exist.
systemctl disable --now nginx || true
