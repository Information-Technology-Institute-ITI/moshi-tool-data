aws_region                 = "eu-central-1"
availability_zone          = "eu-central-1a"
domain_name                = "studio.example.com"
image_tag                  = "0123456789abcdef0123456789abcdef01234567"
worker_token_parameter_name = "/moshi/production/worker-token"
hf_token_parameter_name     = "/moshi/production/huggingface-token"

# Restrict this to office/VPN ranges whenever the site is not intended for the public internet.
public_https_cidrs = ["0.0.0.0/0"]

# Existing SNS topic subscribed to the on-call operator.
alarm_topic_arn = "arn:aws:sns:eu-central-1:123456789012:moshi-production-alerts"
