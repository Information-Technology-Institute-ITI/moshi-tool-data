HF_TOKEN=
MOSHI_WORKER_TOKEN=
MOSHI_DISPATCH_TOKEN=

# The web listener reads its port from the protected runtime environment.
MOSHI_WORKSPACE=
MOSHI_WEB_PORT=80
MOSHI_WEB_BIND_ADDRESS=127.0.0.1
gpu_port=8766

MOSHI_GPU_INTERNAL_URL=http://172.31.26.80:8766
MOSHI_GPU_REQUIRED_BUILD_ID=
MOSHI_GPU_INSTANCE_ID=
AWS_REGION=
MOSHI_DEPLOYMENT_GENERATION=
MOSHI_GPU_IDLE_SECONDS=900
MOSHI_GPU_CHECK_COOLDOWN_SECONDS=600
MOSHI_GPU_COLD_START_COOLDOWN_SECONDS=1800
MOSHI_WORKER_SOURCE_IPS=172.31.26.80
MOSHI_TRUSTED_ORIGINS=
MOSHI_AUTHENTICATED_USER_HEADER=
MOSHI_TRUST_PROXY_AUTH=
MOSHI_LOOPBACK_AUTHENTICATED_USER=
MOSHI_TRIAL_OPERATOR_IPS=
MOSHI_TRIAL_AUTHENTICATED_USER=

# Website accounts and activation email. Keep MOSHI_SMTP_PASSWORD in the
# protected runtime secret file, not in source control.
MOSHI_REQUIRE_SIGN_IN=1
MOSHI_PUBLIC_ORIGIN=
MOSHI_SMTP_HOST=
MOSHI_SMTP_PORT=587
MOSHI_SMTP_USERNAME=
MOSHI_SMTP_PASSWORD=
MOSHI_SMTP_FROM=
MOSHI_SMTP_SECURITY=starttls
MOSHI_EMAIL_VERIFICATION_TTL_SECONDS=86400
MOSHI_EMAIL_RESEND_COOLDOWN_SECONDS=60
MOSHI_AUTH_SESSION_TTL_SECONDS=604800
MOSHI_SESSION_COOKIE_NAME=moshi_session
MOSHI_SESSION_COOKIE_SECURE=1

